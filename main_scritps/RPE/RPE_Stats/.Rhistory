# ==============================================================================
# SCRIPT D'ANALYSE NIRS : Concentrique vs Excentrique à 30% et 50%
# ==============================================================================
# 1. Installation (si nécessaire) et chargement des packages ----
# Décommentez la ligne suivante si les packages ne sont pas encore installés :
# install.packages(c("tidyverse", "lme4", "lmerTest", "emmeans"))
library(tidyverse)  # Pour la manipulation de données et les graphiques (ggplot2)
library(lme4)       # Pour les modèles mixtes linéaires
library(lmerTest)   # Pour obtenir les p-values (valeurs p) du modèle mixte
library(emmeans)    # Pour les comparaisons post-hoc
# 2. Chargement des données ----
# Remplacez "votre_fichier.csv" par le nom exact de votre fichier.
# Note : En France, les CSV utilisent souvent ';' comme séparateur et ',' pour les décimales.
df <- read_csv2("C:/Program Files/DigiMove/DigiMove/DataAnalysisProject/Analysis_Results/hb_summary_final_semaxone.csv")
# 3. Préparation et nettoyage des données ----
# Adaptez les noms de colonnes ("Subject", "Contraction_Mode", "Intensity", "NIRS_Value")
# pour qu'ils correspondent EXACTEMENT à ceux de votre tableau.
df_clean <- df %>%
mutate(
Subject = as.factor(Subject),
Contraction_Mode = as.factor(Contraction_Mode),
# Si l'intensité contient le symbole "%" (ex: "30%"), on le retire pour n'avoir que le chiffre
Intensity = as.factor(gsub("%", "", Intensity))
)
# 1. Choisissez ici votre variable (démentez celle que vous voulez utiliser)
variable_choisie <- "EnvelopeMean_HbR_uM"  # ou "Mean_HbO_uM" ou "Mean_HbTot_uM", ou autre variable de votre choix dans le tableau
# 2. La ligne magique pour créer 'NIRS_Value' dynamiquement
df_clean <- df %>%
mutate(NIRS_Value = .data[[variable_choisie]])
# 4. Statistiques descriptives ----
# Calcule la moyenne et l'écart-type pour chaque croisement de conditions
stats_desc <- df_clean %>%
group_by(Contraction_Mode, Intensity) %>%
summarise(
Moyenne = mean(NIRS_Value, na.rm = TRUE), # Remplacez 'NIRS_Value' par votre variable (ex: Mean_HbR_uM)
Ecart_Type = sd(NIRS_Value, na.rm = TRUE),
N = n(),
.groups = 'drop'
)
print("--- Statistiques Descriptives ---")
print(stats_desc)
# 5. Visualisation des données (Boxplot) ----
# Permet de voir la distribution et les valeurs aberrantes potentielles
graphique <- ggplot(df_clean, aes(x = Intensity, y = NIRS_Value, fill = Contraction_Mode)) +
geom_boxplot(alpha = 0.7) +
theme_minimal() +
labs(
title = "Comparaison des signaux NIRS selon le mode et l'intensité",
x = "Intensité (% MVC)",
y = "Concentration NIRS (µM)",
fill = "Mode de contraction"
) +
scale_fill_manual(values = c("Concentric" = "#4e79a7", "Eccentric" = "#f28e2b"))
print(graphique)
# 6. Modèle Statistique (Analyse de la variance via Modèle Mixte) ----
# On teste l'effet de l'Intensité, du Mode, et de leur Interaction (Intensity * Contraction_Mode)
# (1|Subject) indique que les mesures sont répétées chez les mêmes sujets (effet aléatoire)
modele <- lmer(NIRS_Value ~ Contraction_Mode * Intensity + (1|Subject), data = df_clean)
# Affichage du tableau de l'ANOVA pour voir les effets principaux et l'interaction
print("--- Résultats de l'ANOVA ---")
print(anova(modele))
# 7. Tests Post-Hoc (Comparaisons par paires) ----
# Si l'interaction ou les effets principaux sont significatifs (p < 0.05), on cherche à savoir QUI diffère de QUI.
print("--- Comparaisons Post-Hoc (Correction de Bonferroni) ---")
# Comparaison Concentrique vs Excentrique POUR CHAQUE intensité (30% et 50%)
posthoc_mode_par_intensite <- emmeans(modele, pairwise ~ Contraction_Mode | Intensity, adjust = "bonferroni")
print(posthoc_mode_par_intensite$contrasts)
# Optionnel : Comparaison 30% vs 50% POUR CHAQUE mode
# posthoc_intensite_par_mode <- emmeans(modele, pairwise ~ Intensity | Contraction_Mode, adjust = "bonferroni")
# print(posthoc_intensite_par_mode$contrasts)
